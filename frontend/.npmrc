# openapi-typescript@7.13.0 (ultima versao) ainda declara peer typescript@^5.x,
# mas o projeto usa typescript@~7.0.2. A ferramenta e usada apenas no codegen
# manual (`npm run gen:api`), entao o peer desatualizado e tolerado. Sem isto,
# `npm ci` falha com ERESOLVE e quebra o CI e o build da imagem (frontend/Dockerfile).
# Remover quando o openapi-typescript suportar TypeScript 7.
legacy-peer-deps=true