# Configuração não secreta do Laravel. Copie para app.env (não versionado).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.ebi.exemplo.org.br
DB_CONNECTION=pgsql
DB_DATABASE=ebi
DB_USERNAME=ebi
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=ebi-app
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=biblioteca
