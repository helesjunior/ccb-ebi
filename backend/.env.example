APP_NAME="EBI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ebi
DB_USERNAME=ebi
DB_PASSWORD=ebi
# Convenção twelve-factor: defina DB_PASSWORD_FILE apontando para um arquivo
# com o segredo; sobrepõe DB_PASSWORD (usado pelo infra/compose.yml).
# DB_PASSWORD_FILE=/run/secrets/db_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@ebi.local"
MAIL_FROM_NAME="${APP_NAME}"

# Chave de criptografia dos dados sensíveis (separada da APP_KEY). Gere com:
# php artisan key:generate --show  (ou openssl rand -base64 32)
SENSITIVE_DATA_KEY=

# Liga/desliga a rotina de retenção (expurgo/anonimização de dado sensível).
# Default false: mantida desligada até o DPO aprovar os prazos (RNF-07). Mesmo
# desligada, `php artisan privacidade:expurgar --force` executa conscientemente.
PRIVACIDADE_RETENCAO_ATIVA=false

HORIZON_NAME=ebi

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Buckets do pipeline de arquivos (E08). Se ausentes, usam AWS_BUCKET.
AWS_BUCKET_QUARENTENA=
AWS_BUCKET_LAUDOS=
# Endpoint S3 (S3 compativel no dev, ex.: LocalStack/MinIO; ver
# docker-compose.override.yml). Deixe vazio para usar a AWS real.
AWS_ENDPOINT=
AWS_URL=

# ClamAV (clamd): host e porta do antivirus para o pipeline de arquivos.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

VITE_APP_NAME="${APP_NAME}"